ASPNETCORE_ENVIRONMENT=Development
WEB_PORT=3000
DATABASE_URL=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_GENERATION_MODEL=openai/gpt-oss-120b
NVIDIA_NIM_GENERATION_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_GENERATION_ALLOWED_HOSTS=integrate.api.nvidia.com
NVIDIA_NIM_GENERATION_TIMEOUT_SECONDS=60
NVIDIA_NIM_GENERATION_SECONDARY_MODEL=google/gemma-4-31b-it
NVIDIA_NIM_GENERATION_TERTIARY_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_NIM_GENERATION_QUATERNARY_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_NIM_GENERATION_QUINARY_MODEL=openai/gpt-oss-20b
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_ALLOWED_HOSTS=opencode.ai
OPENCODE_ZEN_TIMEOUT_SECONDS=60
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_SECONDARY_ACCOUNT_ID=
CLOUDFLARE_SECONDARY_API_TOKEN=
CLOUDFLARE_TERTIARY_ACCOUNT_ID=
CLOUDFLARE_TERTIARY_API_TOKEN=
CLOUDFLARE_WORKERS_AI_GENERATION_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_WORKERS_AI_EXPERIMENTAL_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
CLOUDFLARE_WORKERS_AI_EMBEDDING_MODEL=@cf/qwen/qwen3-embedding-0.6b
CLOUDFLARE_WORKERS_AI_GENERATION_TIMEOUT_SECONDS=60
CLOUDFLARE_WORKERS_AI_EMBEDDING_CONNECT_TIMEOUT_SECONDS=10
CLOUDFLARE_WORKERS_AI_EMBEDDING_READ_TIMEOUT_SECONDS=60
QDRANT_COLLECTION_NAME=ringkas_chunks_cf_qwen3_embedding_v2
# Live-verified output dimension for the configured Cloudflare embedding model.
QDRANT_DENSE_VECTOR_SIZE=1024
QDRANT_DENSE_DISTANCE=cosine
RINGKAS_DATA_ROOT=../data
RAG_QUERY_BASE_URL=http://rag-query:8081/
RAG_QUERY_ALLOWED_AUTHORITIES=rag-query:8081
RAG_QUERY_TIMEOUT_SECONDS=30
# Required: same non-whitespace value of at least 32 characters for API and rag-query.
RAG_INTERNAL_TOKEN=
DATA_PROTECTION_KEYS_PATH=/data/ringkas/keys
# Google Console redirect URI: <public-origin>/api/auth/google/provider-callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
PDF_STORAGE_PATH=/data/ringkas/pdfs
GUEST_PROMPT_QUOTA=1
REGISTERED_DAILY_QUOTA=
RAGAS_LLM_API_KEY=
RAGAS_LLM_MODEL=
RAGAS_LLM_BASE_URL=
RAGAS_LLM_PROVIDER=
BPS_API_KEY=
