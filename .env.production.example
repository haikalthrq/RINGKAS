ASPNETCORE_ENVIRONMENT=Production
WEB_PORT=3000
RINGKAS_DATA_ROOT=/data/ringkas

POSTGRES_DB=ringkas
POSTGRES_USER=ringkas
POSTGRES_PASSWORD=<required-secret>
DATABASE_URL=postgresql://ringkas:<url-encoded-password>@postgres:5432/ringkas

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=ringkas_chunks_cf_qwen3_embedding_v2
QDRANT_DENSE_VECTOR_SIZE=1024
QDRANT_DENSE_DISTANCE=cosine

PDF_STORAGE_PATH=/data/ringkas/pdfs
PDF_ALLOWED_HOSTS=webapi.bps.go.id
BPS_API_KEY=<required-secret>
BPS_BASE_URL=https://webapi.bps.go.id/v1/api/list
BPS_PUBLICATIONS_PATH=
BPS_PUBLICATION_KEYWORD=
INGESTION_POLL_INTERVAL_SECONDS=10
INGESTION_RUNNING_JOB_TIMEOUT_SECONDS=21600
INGESTION_DOCUMENT_RETRY_COUNT=2

CLOUDFLARE_ACCOUNT_ID=<required>
CLOUDFLARE_API_TOKEN=<required-secret>
CLOUDFLARE_WORKERS_AI_EMBEDDING_MODEL=@cf/qwen/qwen3-embedding-0.6b
CLOUDFLARE_WORKERS_AI_EMBEDDING_SECONDARY_ACCOUNT_ID=
CLOUDFLARE_WORKERS_AI_EMBEDDING_SECONDARY_API_TOKEN=
CLOUDFLARE_WORKERS_AI_EMBEDDING_TERTIARY_ACCOUNT_ID=
CLOUDFLARE_WORKERS_AI_EMBEDDING_TERTIARY_API_TOKEN=

RAG_INTERNAL_TOKEN=<required-secret-min-32-chars>
DATA_PROTECTION_KEYS_PATH=/data/ringkas/keys

GOOGLE_CLIENT_ID=<required>
GOOGLE_CLIENT_SECRET=<required-secret>
REGISTERED_DAILY_QUOTA=<required-positive-integer>

NVIDIA_NIM_API_KEY=<required-secret>
NVIDIA_NIM_GENERATION_MODEL=mistralai/mistral-small-4-119b-2603
NVIDIA_NIM_GENERATION_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_GENERATION_ALLOWED_HOSTS=integrate.api.nvidia.com
NVIDIA_NIM_GENERATION_TIMEOUT_SECONDS=60
NVIDIA_NIM_GENERATION_SECONDARY_MODEL=nvidia/nemotron-mini-4b-instruct
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_ALLOWED_HOSTS=opencode.ai
OPENCODE_ZEN_TIMEOUT_SECONDS=60
CLOUDFLARE_WORKERS_AI_GENERATION_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_WORKERS_AI_EXPERIMENTAL_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
CLOUDFLARE_WORKERS_AI_GENERATION_TIMEOUT_SECONDS=60

GUEST_PROMPT_QUOTA=1
RAG_QUERY_BASE_URL=http://rag-query:8081/
RAG_QUERY_ALLOWED_AUTHORITIES=rag-query:8081
RAG_QUERY_TIMEOUT_SECONDS=30
OCR_ENABLED=false
